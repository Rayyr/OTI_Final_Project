# Indago Command Script (Fri, 5 Sep 2025 17:46:57 +0300)
#
# Version 24.09.002-s

#
# Markers
#
# CDL at time 45ns

#
# Time Folding
#

#
# Sequence Time Expansions
#

#
# Column Configuration
#
waveform column remove -all
waveform column configure -align left -width 12 name
waveform column configure -align left -width 7 value

#
# Signal List
#
waveform add {top.dut.clk}
waveform add -radix d {top.dut.a_in}
waveform add -radix d {top.dut.b_in}
waveform add -radix d {top.dut.result_ff}
waveform add {top.dut.ap}
waveform add {top.dut.csr_rddata_in}
waveform add {top.dut.csr_ren_in}
waveform add {top.dut.error}
waveform add {top.dut.rst_l}
waveform add {top.dut.scan_mode}
waveform add {top.dut.valid_in}

#
# Visible Time Range
#
waveform xview limits 0ns 45ns

#
# Insertion Point
#
waveform insertion {,10}
